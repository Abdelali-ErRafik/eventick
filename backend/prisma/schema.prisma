// Eventick — PostgreSQL schema (Prisma)
// Money is stored as INTEGER CENTS (Int) everywhere — never floating point.
// All public content is bilingual: every FR field has an AR sibling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  /// Money returned to the buyer. Distinct from CANCELLED, which only voids
  /// tickets and releases stock without moving any money.
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  TRANSFERRED
}

enum PromoKind {
  PERCENT
  AMOUNT
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  /// Commission plan, for organisers. Null for customers, and for an
  /// organiser nobody has assigned one to yet — the finance routes fall back
  /// to the default plan rather than charging nothing.
  planId String? @map("plan_id")

  events   Event[]
  orders   Order[]
  listings ResaleListing[]
  shares   TicketShare[]

  plan        Plan?        @relation(fields: [planId], references: [key], onDelete: SetNull)
  bankAccount BankAccount?
  payouts     Payout[]

  /// Applications this person submitted to become an organiser.
  organiserApplications OrganiserApplication[] @relation("OrganiserApplicant")
  /// Applications this person decided, as an admin.
  reviewedApplications  OrganiserApplication[] @relation("OrganiserReviewer")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Permissions
//
// A user still has exactly ONE role (User.role above). What a role may DO is
// data, not code: RolePermission rows. Adding a capability to organisers is
// an INSERT, not a deploy.
//
// Deliberately NOT modelled:
//   - per-user permission overrides. One role per user, permissions per role.
//     A user needing a different set needs a different role.
//   - row ownership. "Which rows may I touch" stays an ownership check in the
//     route (event.organiserId === user.id). Permissions answer "may I do
//     this kind of thing at all", never "to whose data" — conflating the two
//     is how one organiser ends up able to edit another's events.
// ---------------------------------------------------------------------------

model Permission {
  /// The permission string itself is the primary key (e.g. "events.manage").
  /// Not a cuid: the key is already unique, stable, and human-readable, and a
  /// surrogate id would let a re-seed mint a new id and orphan every
  /// RolePermission row pointing at the old one.
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(cuid())
  role          Role
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  /// Makes seeding idempotent: upsert needs a unique to target, and without
  /// this every re-seed would duplicate the grant rows.
  @@unique([role, permissionKey])
  /// Authorisation reads this by role on (nearly) every authenticated
  /// request, so it gets its own index.
  @@index([role])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  organiserId String?     @map("organiser_id") // null for seeded/platform events
  status      EventStatus @default(PUBLISHED)

  titleFr  String @map("title_fr")
  titleAr  String @map("title_ar")
  category String
  city     String

  venueFr String @map("venue_fr")
  venueAr String @map("venue_ar")
  address String

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")
  doorsAt DateTime @map("doors_at")

  image      String
  badge      String?
  blurbFr    String  @map("blurb_fr")
  blurbAr    String  @map("blurb_ar")
  aboutFr    String  @map("about_fr")
  aboutAr    String  @map("about_ar")
  ageFr      String  @map("age_fr")
  ageAr      String  @map("age_ar")
  popularity Int     @default(0)
  instant    Boolean @default(true) // sold instantly vs waitlist-only when sold out

  /// Hours before the start when buyers may no longer cancel themselves.
  /// 0 disables self-cancellation, leaving it to the organiser.
  cancelCutoffHours Int @default(48) @map("cancel_cutoff_hours")

  createdAt DateTime @default(now()) @map("created_at")

  organiser  User?           @relation(fields: [organiserId], references: [id], onDelete: SetNull)
  tiers      TicketTier[]
  lineup     LineupItem[]
  orders     Order[]
  promoCodes PromoCode[]
  waitlist   WaitlistEntry[]

  @@index([organiserId])
  @@index([status])
  @@map("events")
}

model LineupItem {
  id      String   @id @default(cuid())
  eventId String   @map("event_id")
  day     DateTime
  time    String
  name    String
  genreFr String   @map("genre_fr")
  genreAr String   @map("genre_ar")
  image   String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("lineup_items")
}

model TicketTier {
  id      String @id @default(cuid())
  eventId String @map("event_id")

  nameFr  String @map("name_fr")
  nameAr  String @map("name_ar")
  blurbFr String @map("blurb_fr")
  blurbAr String @map("blurb_ar")

  priceCents  Int      @map("price_cents")
  capacity    Int
  numbered    Boolean  @default(false) // true -> tickets get a row/seat on purchase
  /// Seats per row when `numbered`. Was hardcoded to 12, which only matched
  /// one imaginary venue; a real room has its own row width.
  seatsPerRow Int      @default(12) @map("seats_per_row")
  recommended Boolean  @default(false)
  saveCents   Int?     @map("save_cents") // displayed "you save X" vs buying tiers separately
  perks       String[] @default([]) // e.g. "qr", "lounge", "skip" — drives the VIP/perk filter on Explorer

  zoneFr String @map("zone_fr")
  zoneAr String @map("zone_ar")
  gateFr String @map("gate_fr")
  gateAr String @map("gate_ar")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
  tickets    Ticket[]

  @@index([eventId])
  @@map("ticket_tiers")
}

// ---------------------------------------------------------------------------
// Orders & tickets
// ---------------------------------------------------------------------------

/// An order holds inventory for `holdUntil` before payment is confirmed. The
/// checkout transaction re-checks `holdUntil` and remaining stock atomically —
/// see domain/inventory.ts — so two concurrent buyers can't both win the last
/// seat the way the old client-only Zustand store allowed.
model Order {
  id         String      @id @default(cuid())
  customerId String?     @map("customer_id") // null = guest checkout
  eventId    String      @map("event_id")
  status     OrderStatus @default(PENDING)

  /// Proof of purchase for a buyer who has no account.
  ///
  /// A guest order has no customerId, so there is no user to authorise a
  /// request against — and the id alone cannot stand in for one, because
  /// cuid() embeds a timestamp and counter and was never meant to be secret.
  /// This is: randomBytes(24), handed to the buyer as the `k` parameter of
  /// their confirmation link, and required for anything that reads personal
  /// data or changes a ticket.
  ///
  /// Set for EVERY order, not just guest ones, so a registered buyer can also
  /// use their emailed link without logging in first.
  accessToken String? @unique @map("access_token")

  holderName String @map("holder_name")
  email      String
  phone      String

  subtotalCents Int @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  totalCents    Int @map("total_cents")

  promoCodeId String? @map("promo_code_id")

  holdUntil DateTime? @map("hold_until")

  // Payment metadata. With CMI configured these are filled from the gateway
  // callback; in mock mode (no CMI_CLIENT_ID) from payment-sim.ts.
  paymentRef String? @map("payment_ref")
  cardBrand  String? @map("card_brand")
  cardLast4  String? @map("card_last4")
  cardBank   String? @map("card_bank")

  /// The gateway's own transaction id (CMI's `TransId`). Unique so a replayed
  /// callback can never settle a second order against the same payment.
  gatewayRef String? @unique @map("gateway_ref")

  /// Platform commission on this order, in cents, recorded AT SETTLEMENT from
  /// the organiser's plan at that moment — never recomputed. Moving an
  /// organiser to a cheaper plan must not retroactively change what they owed
  /// on tickets already sold. Null for orders settled before plans existed.
  feeCents   Int?    @map("fee_cents")
  /// Which plan produced `feeCents`, kept so a figure can be explained later
  /// even if the plan's rate has since been edited.
  feePlanKey String? @map("fee_plan_key")

  /// Refund audit trail. `refundedCents` accumulates across partial refunds,
  /// so it is the amount already returned — never the amount outstanding.
  refundedCents Int       @default(0) @map("refunded_cents")
  refundedAt    DateTime? @map("refunded_at")
  refundRef     String?   @map("refund_ref")

  createdAt DateTime @default(now()) @map("created_at")

  customer    User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promoCode   PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  lines       OrderLine[]
  tickets     Ticket[]
  payoutOrder PayoutOrder?

  @@index([customerId])
  @@index([eventId])
  @@index([status, holdUntil]) // the expiry sweep scans PENDING orders by holdUntil
  @@map("orders")
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  tierId  String @map("tier_id")
  qty     Int

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_lines")
}

model Ticket {
  id      String       @id @default(cuid())
  ref     String       @unique // e.g. ET-2026-004815, shown on the e-billet and scanned at the gate
  orderId String       @map("order_id")
  tierId  String       @map("tier_id")
  status  TicketStatus @default(VALID)

  holderName  String    @map("holder_name")
  seatRow     Int?      @map("seat_row")
  seatNumber  Int?      @map("seat_number")
  usedAt      DateTime? @map("used_at")
  /// Set when a buyer cancels their own ticket, as distinct from an
  /// organiser voiding it — the two need telling apart in a dispute.
  cancelledAt DateTime? @map("cancelled_at")
  /// The ref this ticket replaced, when an organiser reissued a lost one.
  /// Keeps the paper trail without reusing a compromised reference.
  replacesRef String?   @map("replaces_ref")

  /// Credential for a holder who is not the buyer.
  ///
  /// A claimed share puts the replacement ticket on the SENDER's order, so the
  /// recipient can never present that order's token — and they should not be
  /// able to, since it would unlock the sender's other tickets too. This gives
  /// them proof of exactly one ticket. Null for ordinary tickets, which are
  /// reached through their order.
  accessToken String? @unique @map("access_token")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier   TicketTier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  resale ResaleListing?
  shares TicketShare[]

  @@index([orderId])
  /// The live entry counter aggregates by status; without this it seq-scans
  /// the whole tickets table on every dashboard refresh.
  @@index([status])
  /// tierId is a relation FK with no implicit index in Postgres.
  @@index([tierId])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      PromoKind
  value     Int // percent (0-100) or amount in cents, per `kind`
  eventId   String?   @map("event_id") // null = valid on any event
  maxUses   Int       @map("max_uses")
  uses      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([eventId])
  @@map("promo_codes")
}

// ---------------------------------------------------------------------------
// Waitlist
// ---------------------------------------------------------------------------

/// One email per event, left when a tier is sold out. Organisers read this
/// list from /pro to know demand; nothing is auto-emailed yet (see docs).
/// Someone waiting for a seat on a sold-out event.
///
/// When a seat frees up the next WAITING entry is OFFERED it: the seat is
/// held for them alone until `claimExpiresAt`, reachable through a private
/// `claimToken`. If they don't buy in time the offer lapses and the seat
/// passes to the next person. Without that window an "a seat is free" email
/// is just a race, which is the experience this queue exists to avoid.
model WaitlistEntry {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  status WaitlistStatus @default(WAITING)

  /// Unguessable, single-purpose: it is the only credential a guest needs to
  /// claim their offer, so it is CSPRNG-drawn and cleared once used.
  claimToken     String?   @unique @map("claim_token")
  claimTierId    String?   @map("claim_tier_id")
  claimExpiresAt DateTime? @map("claim_expires_at")
  offeredAt      DateTime? @map("offered_at")
  claimedAt      DateTime? @map("claimed_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status, createdAt]) // picking the next person in line
  @@index([status, claimExpiresAt]) // expiring stale offers
  @@map("waitlist_entries")
}

enum WaitlistStatus {
  /// In the queue, no seat offered yet.
  WAITING
  /// A seat is held for this person until claimExpiresAt.
  OFFERED
  /// They bought it.
  CLAIMED
  /// Their window lapsed; the seat went to the next person.
  EXPIRED
}

// ---------------------------------------------------------------------------
// Resale
// ---------------------------------------------------------------------------

/// A ticket its owner has put back up for sale.
///
/// Resale is PLATFORM-MEDIATED and at FACE VALUE: the buyer pays Eventick,
/// the seller is refunded what they originally paid, and a fresh ticket is
/// issued to the buyer while the old reference is voided. Nobody hands money
/// to a stranger, and a sold ticket cannot be presented twice.
model ResaleListing {
  id       String       @id @default(cuid())
  ticketId String       @unique @map("ticket_id")
  sellerId String?      @map("seller_id") // null when the original order was a guest checkout
  status   ResaleStatus @default(LISTED)

  /// Face value at listing time, copied so a later tier price change cannot
  /// silently alter what a listed ticket costs.
  priceCents Int @map("price_cents")

  /// Shareable, unguessable listing URL segment.
  token String @unique

  /// The order that bought it, and the ticket issued to that buyer. Both are
  /// set at COMPLETION, so they record a finished sale.
  buyerOrderId String? @map("buyer_order_id")
  newTicketId  String? @map("new_ticket_id")

  /// The order currently attempting to buy this listing, set before the buyer
  /// is sent to the gateway.
  ///
  /// CMI echoes back only our order reference — it has no metadata field to
  /// carry a listing id the way a Stripe PaymentIntent did — so the callback
  /// needs a way to tell "this order bought a resold seat" from "this order
  /// bought fresh inventory". Without it a resale would settle through
  /// settleOrder and issue a ticket against tier stock that was never claimed.
  pendingOrderId String? @unique @map("pending_order_id")

  createdAt DateTime  @default(now()) @map("created_at")
  soldAt    DateTime? @map("sold_at")
  closedAt  DateTime? @map("closed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  seller User?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("resale_listings")
}

enum ResaleStatus {
  /// On sale.
  LISTED
  /// Bought; the seller has been refunded and a new ticket issued.
  SOLD
  /// Withdrawn by the seller, or voided because the ticket changed state.
  CANCELLED
}

/// A ticket its owner has offered to someone else.
///
/// The recipient opens the link and claims it: a NEW ticket with a fresh QR
/// is issued to them and the sender's is voided. The claim step matters —
/// emailing a ticket blind means one typo sends it to a stranger with no way
/// back, and the sender can revoke an unclaimed share at any time.
model TicketShare {
  id       String      @id @default(cuid())
  ticketId String      @map("ticket_id")
  senderId String?     @map("sender_id") // null for guest orders
  status   ShareStatus @default(OPEN)

  /// Unguessable link segment; cleared once claimed so it cannot be reused.
  token String? @unique

  /// Optional note shown to the recipient, e.g. "see you there".
  message String?

  /// The ticket issued to whoever claimed it.
  newTicketId String? @map("new_ticket_id")
  claimedName String? @map("claimed_name")

  createdAt DateTime  @default(now()) @map("created_at")
  claimedAt DateTime? @map("claimed_at")
  revokedAt DateTime? @map("revoked_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([status])
  @@map("ticket_shares")
}

enum ShareStatus {
  /// Waiting for the recipient.
  OPEN
  /// Taken; a new ticket exists and the sender's is void.
  CLAIMED
  /// Withdrawn by the sender, or voided because the ticket changed state.
  REVOKED
}

// ---------------------------------------------------------------------------
// Becoming an organiser
//
// Public registration always creates a CUSTOMER (PUBLIC_SIGNUP_ROLE), and
// admins can mint organisers directly — but nothing let someone ASK. The
// "Créer un événement" button in the header was a dead end: logged out it
// bounced to /login, and a logged-in customer was silently redirected to the
// homepage with no explanation.
//
// An application is deliberately a separate row rather than fields on User:
// it survives the decision (a declined applicant keeps their history, and a
// second application is a second row), and the reviewer needs to see who
// asked, when, and what they said — none of which belongs on the account
// itself.
// ---------------------------------------------------------------------------

model OrganiserApplication {
  id     String                     @id @default(cuid())
  userId String                     @map("user_id")
  status OrganiserApplicationStatus @default(PENDING)

  /// Trading name — the artist, venue or company the events run under. Not
  /// the account's own name, which is a person.
  displayName String @map("display_name")
  /// Reachable number. Approving someone to take money is a decision worth
  /// being able to follow up on.
  phone       String
  /// What they intend to put on, in their words.
  pitch       String

  /// Set when an admin decides. Kept even after a decline, so a repeat
  /// application can be read against the earlier one.
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  /// Why it was declined, shown to the applicant.
  decisionNote String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")

  user       User  @relation("OrganiserApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("OrganiserReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("organiser_applications")
}

enum OrganiserApplicationStatus {
  /// Waiting for an admin to decide.
  PENDING
  /// Approved; the applicant's role was promoted to ORGANISER.
  APPROVED
  /// Turned down. decisionNote says why.
  DECLINED
}

// ---------------------------------------------------------------------------
// Money owed to organisers
//
// Three things used to be fiction here, all of them on the Finance screen: the
// organiser picked their own commission plan from a <select>, the fee was
// computed in the browser and stored nowhere, and "Reversement" named a payout
// that did not exist. These models make the first two real and give the third
// somewhere to live.
//
// The ordering rule throughout: a fee is recorded ON THE ORDER at settlement,
// never recomputed from the plan afterwards. An organiser moved to a cheaper
// plan must not retroactively owe less on tickets already sold, and a payout
// already made must not change value because a rate did.
// ---------------------------------------------------------------------------

/// What the platform charges an organiser. Assigned by an admin — an organiser
/// choosing their own rate is the bug this replaces.
model Plan {
  /// Stable, human-readable key ("starter"), not a cuid: it appears in config
  /// and in the UI, and a re-seed must not orphan the organisers pointing at it.
  key   String @id
  label String

  /// Percentage cut, in BASIS POINTS (500 = 5%). Integer, because a float rate
  /// reintroduces exactly the rounding drift cents exist to avoid.
  rateBps      Int @map("rate_bps")
  /// Fixed monthly fee in cents, on top of the percentage.
  monthlyCents Int @default(0) @map("monthly_cents")

  /// Given to a newly approved organiser when no plan is chosen for them.
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  organisers User[]

  @@map("plans")
}

/// Where an organiser's money goes. Deliberately minimal: a name and an RIB,
/// which is what a Moroccan bank transfer actually needs.
model BankAccount {
  id          String @id @default(cuid())
  organiserId String @unique @map("organiser_id")

  /// Account holder as the bank has it, which is often the trading name
  /// rather than the person who signed up.
  holderName String  @map("holder_name")
  /// Moroccan RIB: 24 digits. Stored as given, digits only.
  rib        String
  bank       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organiser User @relation(fields: [organiserId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

enum PayoutStatus {
  /// Calculated, not yet sent to the bank.
  PENDING
  /// Transfer made. `reference` is the bank's.
  PAID
  /// Abandoned — see `note`.
  CANCELLED
}

/// One transfer to one organiser for one period.
///
/// Totals are FROZEN at creation by copying from the orders in the period,
/// rather than recomputed on read: a refund processed next week must not
/// silently change what we already paid out last week.
model Payout {
  id          String       @id @default(cuid())
  organiserId String       @map("organiser_id")
  status      PayoutStatus @default(PENDING)

  /// Half-open period [periodStart, periodEnd), by order settlement time.
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  /// Ticket revenue in the period, already net of refunds.
  grossCents Int @map("gross_cents")
  /// Platform commission withheld, summed from the orders themselves.
  feeCents   Int @map("fee_cents")
  /// What is actually transferred: gross - fee. Stored rather than derived so
  /// the row remains readable if either input is ever corrected.
  netCents   Int @map("net_cents")

  /// Orders included, so a payout can be reconciled line by line.
  orders PayoutOrder[]

  /// Bank's transfer reference, filled when marked PAID.
  reference String?
  note      String?

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  organiser User @relation(fields: [organiserId], references: [id], onDelete: Restrict)

  @@index([organiserId, status])
  @@index([status])
  @@map("payouts")
}

/// Join row pinning one order into one payout.
///
/// `@@unique([orderId])` is the safeguard that matters: an order can appear in
/// at most ONE payout ever, so a second run over an overlapping period cannot
/// pay for the same tickets twice.
model PayoutOrder {
  id       String @id @default(cuid())
  payoutId String @map("payout_id")
  orderId  String @map("order_id")

  /// Copied from the order at the time of the run, for line-by-line
  /// reconciliation without re-reading orders that may since have changed.
  grossCents Int @map("gross_cents")
  feeCents   Int @map("fee_cents")

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([payoutId])
  @@map("payout_orders")
}
