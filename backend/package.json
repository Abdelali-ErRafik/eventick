{
  "name": "eventick-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API backend for Eventick — Express + Prisma + PostgreSQL (TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node ../scripts/live-api-test.mjs",
    "test:live:authz": "node ../scripts/live-authz-test.mjs",
    "test:live:organiser": "node ../scripts/live-organiser-authz-test.mjs",
    "test:live:guest": "node ../scripts/live-guest-authz-test.mjs",
    "test:live:coverage": "node ../scripts/live-coverage-test.mjs",
    "test:live:share": "node ../scripts/live-share-test.mjs",
    "test:live:refund": "tsx ../scripts/live-refund-webhook-test.mjs",
    "test:live:cmi": "tsx ../scripts/live-cmi-payment-test.mjs",
    "test:live:money": "tsx ../scripts/live-money-test.mjs",
    "test:live:orders": "tsx ../scripts/live-orders-payments-test.mjs",
    "test:live:audit": "tsx ../scripts/live-audit-test.mjs",
    "test:live:ticketing": "tsx ../scripts/live-ticketing-test.mjs",
    "test:live:checks": "tsx ../scripts/live-all-checks.mjs",
    "test:live:sweeper": "tsx ../scripts/live-sweeper-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "resend": "^6.34.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
